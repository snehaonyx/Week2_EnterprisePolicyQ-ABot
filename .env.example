APP_ENV=development
LOG_LEVEL=debug

# Google Gemini API key (embeddings + chat generation) - verify this is
# still the exact env var name langchain-google-genai reads before relying on it
GOOGLE_API_KEY=

# Local Chroma vector store - one collection per workspace, all under
# this directory. No collection-name variable: workspace collection
# names are generated (opaque) or looked up, never a fixed value.
CHROMA_PERSIST_DIR=./data/chroma

# Gemini free-tier flash model for answer generation. Set from web
# research on 2026-08-22 (sources disagreed between gemini-3.6-flash and
# a newly-released gemini-3.7-flash, 9 days old at research time) -
# VERIFY against https://ai.google.dev/gemini-api/docs/pricing before
# the real end-to-end manual test run. This is an env var specifically
# so a rename is a one-line edit here, not a code change.
CHAT_MODEL_NAME=gemini-3.6-flash
